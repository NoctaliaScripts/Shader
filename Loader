--------------------------------------------------------------------------------
-- Game bindings: effects/sky/clouds are found (or created) on demand
--------------------------------------------------------------------------------

local CAM_FX_PREFIX = "Noctalia_Cam"

local function isCamFx(instance)
	return instance.Name:sub(1, #CAM_FX_PREFIX) == CAM_FX_PREFIX
end

local function findInstance(class)
	if class == "Clouds" then
		return workspace.Terrain:FindFirstChildOfClass("Clouds")
	end

	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA(class) and not isCamFx(child) then
			return child
		end
	end

	return nil
end

local function ensureInstance(class)
	local existing = findInstance(class)

	if existing then
		return existing
	end

	local created = Instance.new(class)

	created.Name = "Noctalia_" .. class
	created.Parent = class == "Clouds" and workspace.Terrain or Lighting

	return created
end

local function removeInstance(class)
	if class == "Clouds" then
		for _, child in ipairs(workspace.Terrain:GetChildren()) do
			if child:IsA("Clouds") then
				child:Destroy()
			end
		end

		return
	end

	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA(class) and not isCamFx(child) then
			child:Destroy()
		end
	end
end

local classDefaults = {}

local function defaultOf(class, prop)
	local key = class .. "." .. prop

	if classDefaults[key] == nil then
		local probe = Instance.new(class)
		local ok, value = pcall(function()
			return probe[prop]
		end)

		probe:Destroy()
		classDefaults[key] = { ok = ok, value = value }
	end

	if not classDefaults[key].ok then
		return nil
	end

	return classDefaults[key].value
end

local function targetOf(group, create)
	if group.target == "Lighting" then
		return Lighting
	end

	if create then
		return ensureInstance(group.class)
	end

	return findInstance(group.class)
end

local function propGet(group, name)
	local target = targetOf(group, false)

	if not target then
		return defaultOf(group.class, name)
	end

	local ok, value = pcall(function()
		return target[name]
	end)

	if ok then
		return value
	end

	return nil
end

--------------------------------------------------------------------------------
-- Original state (for Reset)
--------------------------------------------------------------------------------

local original = { props = {}, clones = {} }

local function captureOriginal()
	-- re-running the script keeps the very first snapshot, not an already modified one
	if env.NoctaliaOriginal then
		original = env.NoctaliaOriginal

		return
	end

	for _, group in ipairs(GROUPS) do
		if group.target == "Lighting" then
			for _, prop in ipairs(group.props) do
				local ok, value = pcall(function()
					return Lighting[prop[1]]
				end)

				if ok then
					original.props[prop[1]] = value
				end
			end
		end
	end

	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("PostEffect") or child:IsA("Atmosphere") or child:IsA("Sky") then
			local copy = child:Clone()

			if copy then
				table.insert(original.clones, copy)
			end
		end
	end

	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")

	if clouds then
		original.clouds = clouds:Clone()
	end

	env.NoctaliaOriginal = original
end

captureOriginal()

local origReflect = setmetatable({}, { __mode = "k" })
local reflectValue = nil

local function setReflectance(value)
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("BasePart") and descendant.Name ~= "Terrain" then
			if origReflect[descendant] == nil then
				origReflect[descendant] = descendant.Reflectance
			end

			descendant.Reflectance = value
		end
	end

	reflectValue = value
end

local function restoreReflectance()
	for part, value in pairs(origReflect) do
		if part.Parent then
			part.Reflectance = value
		end
	end

	table.clear(origReflect)
	reflectValue = nil
end

