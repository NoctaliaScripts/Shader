-- World particles. Named layers so presets, rain and snow can run together.
--------------------------------------------------------------------------------

local layers = {}
local layerConn = nil

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local SOFT = "rbxasset://textures/particles/smoke_main.dds"
local TWINKLE = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 1),
	NumberSequenceKeypoint.new(0.25, 0.1),
	NumberSequenceKeypoint.new(0.75, 0.1),
	NumberSequenceKeypoint.new(1, 1),
})

local function sweepParticleParts()
	for _, container in ipairs({ workspace, workspace.CurrentCamera }) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if child.Name == "Noctalia_Particles" or child.Name == "ShaderZ_Particles" then
					child:Destroy()
				end
			end
		end
	end
end

sweepParticleParts()

local function clearLayer(name)
	local layer = layers[name]

	if layer then
		for _, entry in ipairs(layer) do
			entry.part:Destroy()
		end

		layers[name] = nil
	end

	if next(layers) == nil and layerConn then
		layerConn:Disconnect()
		layerConn = nil
	end
end

local function clearAllLayers()
	local names = {}

	for name in pairs(layers) do
		table.insert(names, name)
	end

	for _, name in ipairs(names) do
		clearLayer(name)
	end

	sweepParticleParts()
end

-- cfg: area (Vector3), offset (Vector3 from camera), volume (emit inside the box instead of
-- from its bottom face), rate, life {min,max}, speed {min,max}, size {min,max}, color
-- (ColorSequence), transparency (NumberSequence), accel, texture, emission, streak
local function setLayer(name, amount, ...)
	clearLayer(name)

	local layer = {}

	layers[name] = layer

	for _, cfg in ipairs({ ... }) do
		local camera = workspace.CurrentCamera
		local part = Instance.new("Part")

		part.Name = "Noctalia_Particles"
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Transparency = 1
		part.Size = cfg.area
		part.Position = (camera and camera.CFrame.Position or Vector3.zero) + cfg.offset
		part.Parent = camera or workspace

		local emitter = Instance.new("ParticleEmitter")

		emitter.Enabled = true
		emitter.Shape = Enum.ParticleEmitterShape.Box
		emitter.Texture = cfg.texture or SOFT
		emitter.Rate = cfg.rate * (amount or 1)
		emitter.Lifetime = NumberRange.new(cfg.life[1], cfg.life[2])
		emitter.Speed = NumberRange.new(cfg.speed[1], cfg.speed[2])
		emitter.Size = NumberSequence.new(cfg.size[1], cfg.size[2])
		emitter.Color = cfg.color
		emitter.Transparency = cfg.transparency or NumberSequence.new(0.2)
		emitter.Acceleration = cfg.accel or Vector3.zero
		emitter.LightEmission = cfg.emission or 0
		emitter.LightInfluence = 0
		emitter.RotSpeed = NumberRange.new(-60, 60)
		emitter.Rotation = NumberRange.new(0, 360)
		emitter.LockedToPart = false

		if cfg.volume then
			emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
			emitter.SpreadAngle = Vector2.new(180, 180)
		else
			emitter.EmissionDirection = Enum.NormalId.Bottom
			emitter.SpreadAngle = Vector2.new(4, 4)
		end

		if cfg.streak then
			emitter.Orientation = Enum.ParticleOrientation.VelocityParallel
		end

		emitter.Parent = part
		table.insert(layer, { part = part, emitter = emitter, offset = cfg.offset, baseRate = cfg.rate })
	end

	if not layerConn then
		layerConn = RunService.RenderStepped:Connect(function()
			local camera = workspace.CurrentCamera

			if not camera then
				return
			end

			local position = camera.CFrame.Position

			for _, entries in pairs(layers) do
				for _, entry in ipairs(entries) do
					entry.part.Position = position + entry.offset
				end
			end
		end)
	end
end

local function setLayerAmount(name, amount)
	local layer = layers[name]

	if layer then
		for _, entry in ipairs(layer) do
			entry.emitter.Rate = entry.baseRate * amount
		end
	end
end

local function startParticles(...)
	setLayer("preset", 1, ...)
end

