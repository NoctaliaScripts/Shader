--------------------------------------------------------------------------------
-- Config tab (saved to the executor workspace folder "Noctalia")
--------------------------------------------------------------------------------

local CONFIG_DIR = "Noctalia"
local selectedConfig = nil
local statusLabel = nil

local function setStatus(text)
	if statusLabel then
		statusLabel.Text = text
	end
end

local function fileApiReady()
	if writefile and readfile and listfiles and isfile and delfile and makefolder and isfolder then
		return true
	end

	setStatus("This executor has no file functions, configs unavailable.")

	return false
end

local function configPath(name)
	return CONFIG_DIR .. "/" .. name .. ".json"
end

local function listConfigs()
	local names = {}

	if not fileApiReady() then
		return names
	end

	pcall(function()
		if not isfolder(CONFIG_DIR) then
			makefolder(CONFIG_DIR)
		end

		for _, path in ipairs(listfiles(CONFIG_DIR)) do
			local name = path:match("([^/\\]+)%.json$")

			if name then
				table.insert(names, name)
			end
		end
	end)
	table.sort(names)

	return names
end

local function saveConfig(name)
	local ok, err = pcall(function()
		if not isfolder(CONFIG_DIR) then
			makefolder(CONFIG_DIR)
		end

		writefile(configPath(name), HttpService:JSONEncode(snapshot()))
	end)

	if not ok then
		setStatus("Save failed: " .. tostring(err))
	end

	return ok
end

do
	local body = groupbox(ConfigPage, "Saved Configs", nil, true)
	local dropdown

	dropdown = dropdownRow(body, "Config", listConfigs, function()
		return selectedConfig
	end, function(name)
		selectedConfig = name
		setStatus("Selected " .. name)
	end)

	local nameBox = textboxRow(body, "new config name")

	buttonRow(body, "Create", function()
		if not fileApiReady() then
			return
		end

		local name = nameBox.Text:gsub("[^%w _%-]", ""):match("^%s*(.-)%s*$")

		if name == "" then
			setStatus("Type a name first.")

			return
		end

		if isfile(configPath(name)) then
			setStatus(name .. " already exists. Select it and press Update.")

			return
		end

		if saveConfig(name) then
			selectedConfig = name
			nameBox.Text = ""
			dropdown:refreshOptions()
			syncUI()
			setStatus("Created " .. name)
		end
	end, true)

	buttonRow(body, "Update (overwrite selected)", function()
		if not fileApiReady() then
			return
		end

		if not selectedConfig then
			setStatus("Select a config first.")

			return
		end

		if saveConfig(selectedConfig) then
			setStatus("Updated " .. selectedConfig)
		end
	end)

	buttonRow(body, "Load", function()
		if not fileApiReady() then
			return
		end

		if not selectedConfig or not isfile(configPath(selectedConfig)) then
			setStatus("Select an existing config first.")

			return
		end

		local ok, data = pcall(function()
			return HttpService:JSONDecode(readfile(configPath(selectedConfig)))
		end)

		if ok and type(data) == "table" then
			applyData(data)
			setStatus("Loaded " .. selectedConfig)
		else
			setStatus("Could not read " .. selectedConfig)
		end
	end)

	buttonRow(body, "Delete", function()
		if not fileApiReady() then
			return
		end

		if not selectedConfig then
			setStatus("Select a config first.")

			return
		end

		local deleted = selectedConfig

		pcall(function()
			delfile(configPath(deleted))
		end)

		selectedConfig = nil
		dropdown:refreshOptions()
		syncUI()
		setStatus("Deleted " .. deleted)
	end)

	buttonRow(body, "Refresh", function()
		dropdown:refreshOptions()

		if selectedConfig and not table.find(listConfigs(), selectedConfig) then
			selectedConfig = nil
		end

		syncUI()
		setStatus("Refreshed")
	end)

	statusLabel = labelRow(body, "Configs are saved in the Noctalia folder.")
	statusLabel.Size = UDim2.new(1, 0, 0, 28)
	statusLabel.TextYAlignment = Enum.TextYAlignment.Top
end

