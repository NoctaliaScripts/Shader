-- Snapshots (used by saved configs)
--------------------------------------------------------------------------------

local currentSkyName = nil

local function encodeValue(value)
	if typeof(value) == "Color3" then
		return { __c = { math.floor(value.R * 255 + 0.5), math.floor(value.G * 255 + 0.5), math.floor(value.B * 255 + 0.5) } }
	end

	return value
end

local function decodeValue(value)
	if type(value) == "table" and value.__c then
		return Color3.fromRGB(value.__c[1], value.__c[2], value.__c[3])
	end

	return value
end

local function snapshot()
	local data = { version = 1, lighting = {}, effects = {}, weather = {}, camera = {} }

	for _, group in ipairs(GROUPS) do
		if group.target == "Lighting" then
			for _, prop in ipairs(group.props) do
				local value = propGet(group, prop[1])

				if value ~= nil then
					data.lighting[prop[1]] = encodeValue(value)
				end
			end
		else
			local instance = findInstance(group.class)

			if instance then
				local saved = {}

				for _, prop in ipairs(group.props) do
					local ok, value = pcall(function()
						return instance[prop[1]]
					end)

					if ok then
						saved[prop[1]] = encodeValue(value)
					end
				end

				if group.class == "Sky" then
					saved.faces = {}

					for _, face in ipairs(SKY_FACES) do
						saved.faces[face] = instance["Skybox" .. face]
					end

					saved.skyName = currentSkyName
				end

				data.effects[group.class] = saved
			else
				data.effects[group.class] = false
			end
		end
	end

	data.reflectance = reflectValue
	data.font = fontState.name or "Original"
	data.weather = {
		rain = layers.rain ~= nil,
		snow = layers.snow ~= nil,
		rainAmount = weather.rainAmount,
		snowAmount = weather.snowAmount,
	}

	local settings = {}

	for key, value in pairs(CS) do
		settings[key] = value
	end

	data.camera = { on = Cam.on, settings = settings }

	return data
end

local function applyData(data)
	clearLayer("preset")

	for name, value in pairs(data.lighting or {}) do
		pcall(function()
			Lighting[name] = decodeValue(value)
		end)
	end

	for _, group in ipairs(GROUPS) do
		if group.class then
			local saved = data.effects and data.effects[group.class]

			if saved == false then
				removeInstance(group.class)
			elseif type(saved) == "table" then
				local instance = ensureInstance(group.class)

				for _, prop in ipairs(group.props) do
					if saved[prop[1]] ~= nil then
						pcall(function()
							instance[prop[1]] = decodeValue(saved[prop[1]])
						end)
					end
				end

				if group.class == "Sky" then
					for face, id in pairs(saved.faces or {}) do
						pcall(function()
							instance["Skybox" .. face] = id
						end)
					end

					currentSkyName = saved.skyName
				end
			end
		end
	end

	if data.reflectance then
		setReflectance(data.reflectance)
	else
		restoreReflectance()
	end

	if data.font ~= nil then
		applyFont(data.font)
	end

	local w = data.weather or {}

	weather.rainAmount = w.rainAmount or weather.rainAmount
	weather.snowAmount = w.snowAmount or weather.snowAmount
	setRain(w.rain == true)
	setSnow(w.snow == true)

	local c = data.camera

	if c then
		resetCamSettings()

		for key, value in pairs(c.settings or {}) do
			if CAM_DEFAULTS[key] ~= nil and type(value) == type(CAM_DEFAULTS[key]) then
				CS[key] = value
			end
		end

		if c.on then
			if Cam.on then
				camApplyStyle()
				camApply()

				if CS.flareOn then
					loadFlare()
				end
			else
				Cam.enable()
			end
		else
			Cam.disable()
		end
	end

	syncUI()
end

