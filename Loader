--------------------------------------------------------------------------------
-- Global font: restyles every TextLabel/TextButton/TextBox in the game (own menu excluded)
--------------------------------------------------------------------------------

local fontState = { name = nil, enum = nil, hooked = false }
local origFonts = setmetatable({}, { __mode = "k" })

local FONT_NAMES = { "Original" }

do
	local names = {}

	for _, item in ipairs(Enum.Font:GetEnumItems()) do
		if item.Name ~= "Unknown" then
			table.insert(names, item.Name)
		end
	end

	table.sort(names)

	for _, name in ipairs(names) do
		table.insert(FONT_NAMES, name)
	end
end

local function fontRoots()
	local roots = { PlayerGui, workspace }
	local ok, coreGui = pcall(function()
		return game:GetService("CoreGui")
	end)

	if ok and coreGui then
		table.insert(roots, coreGui)
	end

	return roots
end

local function styleText(object)
	if not fontState.enum then
		return
	end

	if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
		local ok, ours = pcall(function()
			local gui = object:FindFirstAncestorWhichIsA("ScreenGui")

			return gui ~= nil and gui.Name:sub(1, 9) == "Noctalia_"
		end)

		if ok and ours then
			return
		end

		-- Roblox's icons (chat, voice, leave...) use custom icon fonts: leave those alone.
		-- Their Font enum reads Unknown, and their glyphs sit in the private-use range.
		local isIcon = false

		pcall(function()
			if object.Font == Enum.Font.Unknown and origFonts[object] == nil then
				isIcon = true

				return
			end

			for _, code in utf8.codes(object.Text) do
				if code >= 0xE000 and code <= 0xF8FF then
					isIcon = true

					return
				end
			end
		end)

		if isIcon then
			return
		end

		pcall(function()
			if origFonts[object] == nil then
				origFonts[object] = object.FontFace
			end

			object.Font = fontState.enum
		end)
	end
end

local function applyFont(name)
	if name == nil or name == "Original" then
		fontState.enum, fontState.name = nil, nil

		for object, face in pairs(origFonts) do
			if object.Parent then
				pcall(function()
					object.FontFace = face
				end)
			end
		end

		table.clear(origFonts)

		return
	end

	fontState.name = name
	fontState.enum = Enum.Font[name]

	if not fontState.hooked then
		fontState.hooked = true

		for _, root in ipairs(fontRoots()) do
			connect(root.DescendantAdded, function(object)
				task.defer(styleText, object)
			end)
		end
	end

	task.spawn(function()
		local count = 0

		for _, root in ipairs(fontRoots()) do
			for _, object in ipairs(root:GetDescendants()) do
				styleText(object)
				count += 1

				if count % 1500 == 0 then
					task.wait()
				end
			end
		end
	end)
end

local function resetAll()
	applyFont(nil)
	clearAllLayers()

	for _, child in ipairs(Lighting:GetChildren()) do
		if (child:IsA("PostEffect") or child:IsA("Atmosphere") or child:IsA("Sky")) and not isCamFx(child) then
			child:Destroy()
		end
	end

	removeInstance("Clouds")

	for _, clone in ipairs(original.clones) do
		clone:Clone().Parent = Lighting
	end

	if original.clouds then
		original.clouds:Clone().Parent = workspace.Terrain
	end

	for name, value in pairs(original.props) do
		pcall(function()
			Lighting[name] = value
		end)
	end

	restoreReflectance()
end

