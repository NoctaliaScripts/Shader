local function formatNumber(value, step)
	local decimals = step >= 1 and 0 or (step >= 0.1 and 1 or 2)

	return string.format("%." .. decimals .. "f", value)
end

local function sliderRow(body, name, min, max, step, curve, getValue, setValue)
	curve = curve or 1

	local row = new("Frame", { Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1 }, body)

	new("TextLabel", {
		Size = UDim2.new(1, -70, 0, 18),
		BackgroundTransparency = 1,
		Text = name,
		TextColor3 = TEXT,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.Gotham,
		TextSize = 11,
	}, row)

	local valueBox = new("TextBox", {
		Size = UDim2.new(0, 64, 0, 18),
		Position = UDim2.new(1, -64, 0, 0),
		BackgroundColor3 = ITEM,
		TextColor3 = ACCENT,
		Font = Enum.Font.GothamBold,
		TextSize = 11,
		ClearTextOnFocus = false,
		Text = "",
	}, row)

	corner(valueBox, 4)

	local track = new("Frame", {
		Size = UDim2.new(1, 0, 0, 6),
		Position = UDim2.new(0, 0, 0, 27),
		BackgroundColor3 = Color3.fromRGB(45, 45, 45),
		BorderSizePixel = 0,
	}, row)

	corner(track, 3)

	local fill = new("Frame", { BackgroundColor3 = ACCENT, BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0) }, track)

	corner(fill, 3)

	local knob = new("Frame", {
		Size = UDim2.new(0, 12, 0, 12),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 2,
	}, track)

	corner(knob, 6)

	local hit = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.new(0, 0, 0, 20),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 3,
	}, row)

	local dragging = false

	local function show(value)
		value = math.clamp(value, min, max)

		local rel = ((value - min) / (max - min)) ^ (1 / curve)

		fill.Size = UDim2.new(rel, 0, 1, 0)
		knob.Position = UDim2.new(rel, 0, 0.5, 0)
		valueBox.Text = formatNumber(value, step)
	end

	local function commit(value)
		value = math.clamp(math.floor(value / step + 0.5) * step, min, max)
		show(value)
		setValue(value)
	end

	local function fromX(x)
		local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)

		commit(min + (max - min) * rel ^ curve)
	end

	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true

			if activeScroller then
				activeScroller.ScrollingEnabled = false
			end

			fromX(input.Position.X)
		end
	end)
	connect(UserInputService.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			fromX(input.Position.X)
		end
	end)
	connect(UserInputService.InputEnded, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false

			if activeScroller then
				activeScroller.ScrollingEnabled = true
			end
		end
	end)

	valueBox.FocusLost:Connect(function()
		local typed = tonumber(valueBox.Text)

		if typed then
			commit(typed)
		else
			show(getValue() or min)
		end
	end)

	table.insert(refreshers, function()
		if not dragging and not valueBox:IsFocused() then
			show(getValue() or min)
		end
	end)
	show(getValue() or min)

	return row
end

