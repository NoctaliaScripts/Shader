end

-- Hides the game's own sky (it would override ours) until the next reset. skybox is an
-- optional table of rbxassetid:// ids: { Bk, Dn, Ft, Lf, Rt, Up }
local function addSky(starCount, skybox)
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("Sky") then
			table.insert(hiddenSkies, child)
			child.Parent = nil
		end
	end

	local sky = addEffect("Sky", {
		StarCount = starCount,
		CelestialBodiesShown = true,
	})

	if skybox then
		sky.SkyboxBk = skybox.Bk
		sky.SkyboxDn = skybox.Dn
		sky.SkyboxFt = skybox.Ft
		sky.SkyboxLf = skybox.Lf
		sky.SkyboxRt = skybox.Rt
		sky.SkyboxUp = skybox.Up
	end

	sky.Name = "ShaderZ_Sky"
end

