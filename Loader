local function prettify(name)
	return (name:gsub("_", " "):gsub("(%l)(%u)", "%1 %2"))
end

local function buildProp(body, group, prop)
	local name, kind, min, max, step, curve = unpack(prop)

	local function get()
		return propGet(group, name)
	end

	local function set(value)
		local existed = group.target == "Lighting" or findInstance(group.class) ~= nil
		local target = targetOf(group, true)

		pcall(function()
			target[name] = value
		end)

		if not existed then
			task.defer(syncUI)
		end
	end

	if kind == "number" then
		sliderRow(body, prettify(name), min, max, step, curve, get, set)
	elseif kind == "color" then
		colorRow(body, prettify(name), get, set)
	else
		toggleRow(body, prettify(name), function()
			return get() == true
		end, set)
	end
end

local function applySkybox(entry)
	local sky = ensureInstance("Sky")

	if entry.faces then
		sky.SkyboxBk = entry.faces.Bk
		sky.SkyboxDn = entry.faces.Dn
		sky.SkyboxFt = entry.faces.Ft
		sky.SkyboxLf = entry.faces.Lf
		sky.SkyboxRt = entry.faces.Rt
		sky.SkyboxUp = entry.faces.Up
	end

	for key, value in pairs(entry.props or {}) do
		pcall(function()
			sky[key] = value
		end)
	end

	currentSkyName = entry.name
end

local function parseSkyIds(text)
	local ids = {}

	for id in text:gmatch("%d+") do
		table.insert(ids, id)
	end

	if #ids == 1 then
		for i = 2, 6 do
			ids[i] = ids[1]
		end
	end

	if #ids ~= 6 then
		return nil
	end

	local faces = {}

	for i, face in ipairs(SKY_FACES) do
		faces[face] = "rbxassetid://" .. ids[i]
	end

	return faces
end

