-- Camera settings (optional): smooth camera, FOV, VHS / bodycam look, lens flare
--------------------------------------------------------------------------------

local Cam = { on = false }

local CAM_DEFAULTS = {
	style = 1,
	smoothOn = true,
	lag = 0.60,
	speed = 1,
	bounce = 0.78,
	tilt = 0.40,
	fovOn = false,
	fov = 70,
	fxOn = true,
	vhs = 0.70,
	scan = 0.50,
	glitch = 0.50,
	crt = 0.40,
	bc = 0.60,
	bcVig = 0.35,
	bright = 0,
	gray = 0,
	flareOn = false,
	flare = 0.60,
	tsOn = true,
	fp = 0.50,
}

local CS = {}

local function resetCamSettings()
	for key, value in pairs(CAM_DEFAULTS) do
		CS[key] = value
	end
end

resetCamSettings()

local cam = workspace.CurrentCamera
local camGui, overlay, scanGroup, crtFrame, crtCorner, bar
local playTxt, recTxt, timeTxt, dateTxt, stampTxt, recDot
local camEdges = {}
local fx = {}
local glitchT = 0
local camConn = nil
local rng = Random.new()
local t0 = os.clock()

local function camLabel(text, pos, anchor)
	return new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		Font = Enum.Font.Arcade,
		TextSize = 38,
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0.4,
		AnchorPoint = anchor,
		Position = pos,
		Size = UDim2.new(0, 340, 0, 44),
		TextXAlignment = anchor.X == 1 and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left,
	}, overlay)
end

local function buildOverlay()
	if camGui then
		return
	end

	camGui = new("ScreenGui", {
		Name = "Noctalia_CamOverlay",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = 50,
		Enabled = false,
	}, guiParent)
	overlay = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, camGui)
	scanGroup = new("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, overlay)

	for i = 0, math.floor(math.max(cam.ViewportSize.Y, 1440) / 4) do
		new("Frame", {
			Size = UDim2.new(1, 0, 0, 1),
			Position = UDim2.new(0, 0, 0, i * 4),
			BackgroundColor3 = Color3.new(0, 0, 0),
