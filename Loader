local function resetGlitch()
	glitchT = 0

	if bar then
		bar.Size = UDim2.new(1, 0, 0, 36)
		bar.BackgroundTransparency = 0.93
	end
end

local function camApplyStyle()
	if not camGui then
		return
	end

	local function styleLabel(label, font, size, width)
		label.Font = font
		label.TextSize = size
		label.Size = UDim2.new(0, width, 0, size + 6)
	end

	if CS.style == 2 then
		for _, label in ipairs({ recTxt, timeTxt, stampTxt }) do
			styleLabel(label, Enum.Font.Code, 22, label == stampTxt and 480 or 220)
			label.TextStrokeTransparency = 0.15
		end

		recTxt.Text = "REC"
		recTxt.Position = UDim2.new(0, 44, 0, 14)
		recDot.Position = UDim2.new(0, 22, 0, 14 + 14)
		stampTxt.AnchorPoint = Vector2.new(1, 0)
		stampTxt.Position = UDim2.new(1, -22, 0, 14)
	else
		for _, label in ipairs({ playTxt, recTxt, timeTxt, dateTxt, stampTxt }) do
			styleLabel(label, Enum.Font.Arcade, 38, 340)
			label.TextStrokeTransparency = 0.4
		end

		recTxt.Text = "● REC"
		recTxt.Position = UDim2.new(0, 22, 0, 56)
		stampTxt.AnchorPoint = Vector2.new(1, 1)
		stampTxt.Position = UDim2.new(1, -22, 1, -60)
	end
end

local function updateStamp()
	local now = os.date("*t")

	if CS.style == 2 then
		stampTxt.Text = os.date("%Y-%m-%d %H:%M:%S")
	else
		local hour = now.hour % 12

		if hour == 0 then
			hour = 12
		end

		stampTxt.Text = string.format("%02d:%02d:%02d %s", hour, now.min, now.sec, now.hour < 12 and "AM" or "PM")
		dateTxt.Text = os.date("%b %d %Y"):upper()
	end
end

local function camApply()
	if not Cam.on or not camGui then
		return
	end

	local vhsMode = CS.style ~= 2
	local v = (CS.fxOn and vhsMode) and CS.vhs or 0
	local b = (CS.fxOn and not vhsMode) and CS.bc or 0

	fx.cc.Enabled, fx.blur.Enabled, fx.bloom.Enabled = CS.fxOn, CS.fxOn, CS.fxOn and vhsMode

	if vhsMode then
		fx.cc.Saturation = -0.22 * v
		fx.cc.Contrast = -0.12 * v
		fx.cc.Brightness = 0.03 * v
		fx.cc.TintColor = Color3.fromRGB(255, 255 - math.floor(16 * v), 255 - math.floor(8 * v))
		fx.blur.Size = 2.2 * v
		fx.bloom.Intensity = 0.45 * v
	else
		fx.cc.Saturation = -0.10 * b
		fx.cc.Contrast = 0.10 * b
		fx.cc.Brightness = 0
		fx.cc.TintColor = Color3.fromRGB(255 - math.floor(8 * b), 255 - math.floor(3 * b), 255)
		fx.blur.Size = 0.9 * b
		fx.bloom.Intensity = 0
	end

	overlay.Visible = CS.fxOn
	scanGroup.Visible = vhsMode
	bar.Visible = vhsMode
	playTxt.Visible = vhsMode
	dateTxt.Visible = vhsMode
	recDot.Visible = not vhsMode
	stampTxt.Visible = CS.tsOn

	for _, edge in ipairs(camEdges) do
		edge.BackgroundTransparency = vhsMode and 0 or (1 - 0.8 * CS.bcVig)
	end

	fx.ccBright.Enabled = math.abs(CS.bright) > 0.001
	fx.ccBright.Brightness = CS.bright
	fx.ccGray.Enabled = CS.gray > 0.001
	fx.ccGray.Saturation = -CS.gray
	scanGroup.GroupTransparency = 1 - 0.45 * CS.scan

	local c = vhsMode and CS.crt or CS.bcVig * 0.4

	crtFrame.Visible = c > 0.01
	crtFrame.Position = UDim2.fromOffset(c * 14, c * 14)
	crtFrame.Size = UDim2.new(1, -c * 28, 1, -c * 28)
	crtCorner.CornerRadius = UDim.new(0, c * 70)
end

local function setCamStyle(style)
	CS.style = style
	resetGlitch()
	camApplyStyle()
	camApply()
	updateStamp()
end

-- Smooth camera (spring) -------------------------------------------------------

local sYaw, sPitch, vYaw, vPitch, roll = nil, 0, 0, 0, 0
local uYaw, prevTYaw = nil, nil
local rawCF, rawFocus = nil, nil
local fpState, fpBlend = false, 0
local origFov, curFov = nil, nil

local function angDiff(a, b)
	return (b - a + math.pi) % (2 * math.pi) - math.pi
end

local function resetCamState()
	sYaw, vYaw, vPitch, roll = nil, 0, 0, 0
	uYaw, prevTYaw = nil, nil
	rawCF, rawFocus = nil, nil
	fpState, fpBlend = false, 0
end

local function camStep(dt)
	local current = workspace.CurrentCamera

	if current and current ~= cam then
		cam = current
		resetCamState()
	end

	if cam.CameraType == Enum.CameraType.Scriptable then
		resetCamState()

		return
	end

	dt = math.min(dt, 1 / 20)

	if CS.fovOn then
		if not origFov then
			origFov = cam.FieldOfView
			curFov = origFov
		end

		curFov = curFov + (CS.fov - curFov) * (1 - math.exp(-14 * dt))

		if math.abs(CS.fov - curFov) < 0.05 then
			curFov = CS.fov
		end

		cam.FieldOfView = curFov
	elseif origFov then
		cam.FieldOfView = origFov
		origFov = nil
	end

	local target = cam.CFrame

	rawCF = target
	rawFocus = cam.Focus

	local focus = rawFocus.Position
	local focusDist = (target.Position - focus).Magnitude
	local head = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
	local dist = focusDist

	if head and head:IsA("BasePart") then
		dist = math.min(focusDist, (target.Position - head.Position).Magnitude)
	end

	if fpState then
		fpState = dist < 1.3
	else
		fpState = dist < 1.0
	end

	local fp = fpState or LocalPlayer.CameraMode == Enum.CameraMode.LockFirstPerson
	local look = target.LookVector
	local tYaw = math.atan2(-look.X, -look.Z)
	local tPitch = math.asin(math.clamp(look.Y, -1, 1))
	local teleported = false

	if not prevTYaw then
		uYaw, prevTYaw = tYaw, tYaw
		teleported = true
	else
		local d = angDiff(prevTYaw, tYaw)

		if math.abs(d) > 2.6 then
			teleported = true
		end

		uYaw = uYaw + d
		prevTYaw = tYaw
	end

	if math.abs(uYaw) > 100 then
		local shift = math.floor(uYaw / (2 * math.pi)) * 2 * math.pi

		uYaw = uYaw - shift

		if sYaw then
			sYaw = sYaw - shift
		end
	end

	local yaw, pitch, rollNow = tYaw, tPitch, 0

	if CS.smoothOn then
		if not sYaw or teleported then
			sYaw, sPitch, vYaw, vPitch = uYaw, tPitch, 0, 0
		end

		local w0 = (24 - 21 * CS.lag) * CS.speed
		local zeta = 1 - 0.45 * CS.bounce
		local k, c = w0 * w0, 2 * zeta * w0
		local steps = math.max(1, math.ceil(dt / (1 / 120)))
		local h = dt / steps

		for _ = 1, steps do
			vYaw = vYaw + (k * (uYaw - sYaw) - c * vYaw) * h
			vPitch = vPitch + (k * (tPitch - sPitch) - c * vPitch) * h
			sYaw = sYaw + vYaw * h
			sPitch = sPitch + vPitch * h
		end

		sPitch = math.clamp(sPitch, -1.5, 1.5)

		local mix = math.clamp(CS.lag / 0.15, 0, 1)

		yaw = uYaw + (sYaw - uYaw) * mix
		pitch = tPitch + (sPitch - tPitch) * mix

		local wantRoll = math.clamp(vYaw * mix * CS.tilt * 0.08, -0.3, 0.3)

		roll = roll + (wantRoll - roll) * (1 - math.exp(-10 * dt))
		rollNow = roll
	else
		sYaw, vYaw, vPitch = nil, 0, 0
		roll = roll + (0 - roll) * (1 - math.exp(-10 * dt))
		rollNow = fp and 0 or roll
	end

	local rot, pos

	if fp then
		pos = target.Position
		rot = CS.smoothOn and CFrame.fromEulerAnglesYXZ(pitch, yaw, rollNow) or target.Rotation
	else
		rot = CFrame.fromEulerAnglesYXZ(pitch, yaw, rollNow)

		local rotFlat = CFrame.fromEulerAnglesYXZ(pitch, yaw, 0)
		local off = target.Rotation:VectorToObjectSpace(target.Position - focus)

		pos = focus + rotFlat:VectorToWorldSpace(off)
	end

	fpBlend = fpBlend + ((fp and 1 or 0) - fpBlend) * (1 - math.exp(-12 * dt))

	local push = 0

	if fpBlend > 0.001 then
		local lv = rot.LookVector
		local flat = Vector3.new(lv.X, 0, lv.Z)

		if flat.Magnitude > 1e-3 then
			push = math.min((CS.fp * 3.0 + math.max(0, -lv.Y) * CS.fp * 1.5) * fpBlend, 5)
			pos = pos + flat.Unit * push
		end
	end

	cam.CFrame = CFrame.new(pos) * rot

	if push > 0.01 then
		cam.Focus = CFrame.new(pos + rot.LookVector)
	end
end

local function camRestore()
	if rawCF and cam.CameraType ~= Enum.CameraType.Scriptable then
		cam.CFrame = rawCF

		if rawFocus then
			cam.Focus = rawFocus
		end
	end
end

-- VHS timestamps / glitch ------------------------------------------------------

local function overlayTick(dt)
	if not CS.fxOn then
		return
	end

	local now = os.clock()
	local elapsed = math.floor(now - t0)

	timeTxt.Text = string.format("%02d:%02d:%02d", elapsed // 3600, (elapsed // 60) % 60, elapsed % 60)

	local blink = (math.floor(now * 1.5) % 2 == 0) and 0 or 1

	recTxt.TextTransparency = blink
	recDot.BackgroundTransparency = blink
	updateStamp()

	if glitchT <= 0 then
		bar.Position = UDim2.new(0, 0, ((now * 0.12) % 1.2) - 0.1, 0)

		if rng:NextNumber() < CS.glitch * 0.012 then
			glitchT = rng:NextNumber(0.08, 0.25)
		end
	end

	if glitchT > 0 then
		glitchT -= dt

		if CS.style == 2 then
			fx.blur.Size = 0.9 * CS.bc + rng:NextNumber(0.6, 1.8) * CS.glitch
		else
			fx.cc.TintColor = Color3.fromRGB(255, rng:NextInteger(215, 255), rng:NextInteger(215, 255))
			fx.blur.Size = 2.2 * CS.vhs + rng:NextNumber(2, 7) * CS.glitch
			bar.BackgroundTransparency = 0.8
			bar.Size = UDim2.new(1, 0, 0, rng:NextInteger(20, 90))
			bar.Position = UDim2.new(0, 0, rng:NextNumber(0, 1), 0)
		end

		if glitchT <= 0 then
			resetGlitch()
			camApply()
		end
	end
end

-- Lens flare (downloads the flare emitters from the asset below) ---------------

local FLARE_ASSET_ID = 89532403908041
local FLARE_STYLE = "Default"
local FLARE_FILE = "LensFlare.rbxm"
local FL_RAYS, FL_RAY_RADIUS, FL_TRANSP_LIMIT = 5, 7, 0.666
local FL_SUN_ANGLE, FL_SUN_BRIGHT = 30, 2.5
local FL_EXPOSURE_ADJ, FL_EXPOSURE_TIME = -2.25, 1

local FL_ATTR_DEFAULTS = {
	ColorBlend = 0,
	Position = Vector3.new(1, 1, 1),
	PositionMult = 1,
	Rotates = false,
	SizeFade = NumberSequence.new(1),
	SquashFade = NumberSequence.new(0),
	TransparencyFade = NumberSequence.new(0),
}

local flareSys = { ready = false, loading = false, status = "off", items = {} }

local function evalSeq(seq, t)
	local kp = seq.Keypoints

	if t <= 0 then
		return kp[1].Value
	end

	if t >= 1 then
		return kp[#kp].Value
	end

	for i = 1, #kp - 1 do
		local a, b = kp[i], kp[i + 1]

		if t >= a.Time and t < b.Time then
			return a.Value + (b.Value - a.Value) * ((t - a.Time) / (b.Time - a.Time))
		end
	end

	return kp[#kp].Value
end

local flareRays = {}

for i = 1, FL_RAYS do
	local ang = math.pi * 2 * ((i - 1) / FL_RAYS)

	flareRays[i] = { math.cos(ang) * FL_RAY_RADIUS, math.sin(ang) * FL_RAY_RADIUS }
end

local flareRP = RaycastParams.new()

flareRP.FilterType = Enum.RaycastFilterType.Exclude
flareRP.IgnoreWater = true

local flareRPChar, flareFilterReset = nil, 0

local function diagFov()
	local ok, d = pcall(function()
		return cam.DiagonalFieldOfView
	end)

	if ok and type(d) == "number" and d > 0 then
		return d
	end

	local v = cam.ViewportSize
	local aspect = v.X / math.max(v.Y, 1)

	return math.deg(2 * math.atan(math.tan(math.rad(cam.FieldOfView) / 2) * math.sqrt(1 + aspect * aspect)))
end

local function updateFlareColors()
	local h, sat = Lighting.ColorShift_Top:ToHSV()

	for _, item in ipairs(flareSys.items) do
		if item.a.ColorBlend > 0 then
			item.color = ColorSequence.new(Color3.fromHSV(h, sat * item.a.ColorBlend, 1))
		end
	end
end

local function buildFlare(styleFolder)
	local items = {}

	for _, asset in ipairs(styleFolder:GetChildren()) do
		if asset:IsA("ParticleEmitter") then
			local attachment = Instance.new("Attachment")

			attachment.Name = "Noctalia_Flare_" .. asset.Name
			attachment.Parent = cam

			local emitter = asset:Clone()

			emitter.ZOffset = 0
			emitter.Enabled = false
			emitter.Parent = attachment

			local attrs = {}

			for key, default in pairs(FL_ATTR_DEFAULTS) do
				local value = emitter:GetAttribute(key)

				if value == nil then
					value = default
				end

				attrs[key] = value
			end

			table.insert(items, { att = attachment, em = emitter, a = attrs })
		end
	end

	return items
end

local function loadFlare()
	if flareSys.ready or flareSys.loading then
		return
	end

	flareSys.loading = true
	flareSys.status = "loading..."

	task.spawn(function()
		local function findStyle(list)
			for _, object in ipairs(list or {}) do
				local folder = (object.Name == "Assets") and object or object:FindFirstChild("Assets", true)
				local style = folder and folder:FindFirstChild(FLARE_STYLE)

				if style then
					return style
				end
			end
		end

		local style
		local okA, objects = pcall(function()
			return game:GetObjects("rbxassetid://" .. FLARE_ASSET_ID)
		end)

		if okA then
			style = findStyle(objects)
		end

		if not style and getcustomasset and isfile and isfile(FLARE_FILE) then
			local okB, objects2 = pcall(function()
				return game:GetObjects(getcustomasset(FLARE_FILE))
			end)

			if okB then
				style = findStyle(objects2)
			end
		end

		if style then
			local okC, items = pcall(buildFlare, style)

			if okC and #items > 0 then
				flareSys.items = items
				updateFlareColors()
				flareSys.ready = true
				flareSys.status = "ready"
			else
				flareSys.status = "build failed"
			end
		else
			flareSys.status = "asset not found"
		end

		flareSys.loading = false
		syncUI()
	end)
end

local exposureAlpha, appliedExposure = 0, 0

local function flareUpdate(dt)
	local enabled = Cam.on and CS.flareOn and flareSys.ready
	local newAlpha = 0

	if enabled then
		for _, item in ipairs(flareSys.items) do
			if item.att.Parent ~= cam then
				item.att.Parent = cam
			end
		end

		local sunDir = Lighting:GetSunDirection()
		local camCF = cam.CFrame
		local camPos = camCF.Position
		local partPos = camPos + sunDir * 5000
		local sunAlpha = math.clamp(sunDir.Y * 90 / FL_SUN_ANGLE, 0, 1)
		local brightAlpha = math.clamp(Lighting.Brightness / FL_SUN_BRIGHT, 0, 1)
		local strength = sunAlpha * brightAlpha * CS.flare

		if strength > 0.001 then
			local dir = partPos - camPos
			local dist = dir.Magnitude
			local ang = math.acos(math.clamp(camCF.LookVector:Dot(dir.Unit), -1, 1))
			local alpha = math.clamp(ang / math.rad(diagFov()) * 2, 0, 1)

			if alpha < 1 then
				local sp = cam:WorldToViewportPoint(partPos)
				local pos = cam:ViewportPointToRay(sp.X, sp.Y, 1).Origin
				local offset = camCF:PointToObjectSpace(pos)
				local char = LocalPlayer.Character
				local now = os.clock()

				if char ~= flareRPChar or now > flareFilterReset then
					flareRPChar, flareFilterReset = char, now + 2
					flareRP.FilterDescendantsInstances = char and { char } or {}
				end

				local norm = (cam.ViewportSize / Vector2.new(1920, 1080)).Magnitude
				local hits = 0

				for _, o in ipairs(flareRays) do
					local ray = cam:ViewportPointToRay(sp.X + o[1] * norm, sp.Y + o[2] * norm, 1)
					local result = workspace:Raycast(ray.Origin, ray.Direction * dist, flareRP)

					if result then
						local inst = result.Instance

						if inst:IsA("BasePart") and (inst.Transparency > FL_TRANSP_LIMIT or inst.LocalTransparencyModifier > FL_TRANSP_LIMIT) then
							flareRP:AddToFilter(inst)
						else
							hits += 1
						end
					end
				end

				local hitAlpha = hits / FL_RAYS

				if hitAlpha < 1 then
					newAlpha = strength * (1 - alpha) * (1 - hitAlpha)

					for _, item in ipairs(flareSys.items) do
						local a, em = item.a, item.em
						local x = offset.X * a.Position.X * a.PositionMult
						local y = offset.Y * a.Position.Y * a.PositionMult

						item.att.Position = Vector3.new(x, y, offset.Z)
						em:Clear()
						em.Size = NumberSequence.new(evalSeq(a.SizeFade, alpha))
						em.Squash = NumberSequence.new(evalSeq(a.SquashFade, alpha))

						local tr = evalSeq(a.TransparencyFade, alpha)

						em.Transparency = NumberSequence.new(tr + (1 - tr) * hitAlpha)
						pcall(function()
							em.LocalTransparencyModifier = 1 - strength
						end)

						if item.color then
							em.Color = item.color
						end

						if a.Rotates then
							em.Rotation = NumberRange.new(math.deg(math.atan2(offset.Y, offset.X)))
						end

						em.ZOffset = math.min(-offset.Z * 0.8, 0)
						em.Lifetime = NumberRange.new(dt * 3)
						em:Emit(1)
					end
				end
			end
		end
	end

	local target = newAlpha * newAlpha

	exposureAlpha = exposureAlpha + (target - exposureAlpha) * (1 - math.exp(-dt * 3 / FL_EXPOSURE_TIME))

	local adjust = exposureAlpha * FL_EXPOSURE_ADJ

	Lighting.ExposureCompensation = Lighting.ExposureCompensation + (adjust - appliedExposure)
	appliedExposure = adjust
end

-- Enable / disable -------------------------------------------------------------

function Cam.enable()
	if Cam.on then
		return
	end

	Cam.on = true
	buildOverlay()
	camGui.Enabled = true

	fx.cc = new("ColorCorrectionEffect", { Name = CAM_FX_PREFIX .. "_CC" }, Lighting)
	fx.ccBright = new("ColorCorrectionEffect", { Name = CAM_FX_PREFIX .. "_Brightness" }, Lighting)
	fx.ccGray = new("ColorCorrectionEffect", { Name = CAM_FX_PREFIX .. "_Gray" }, Lighting)
	fx.blur = new("BlurEffect", { Name = CAM_FX_PREFIX .. "_Blur" }, Lighting)
	fx.bloom = new("BloomEffect", { Name = CAM_FX_PREFIX .. "_Bloom", Size = 24, Threshold = 0.9 }, Lighting)

	camApplyStyle()
	camApply()
	updateStamp()

	RunService:BindToRenderStep("NoctaliaSmoothCam", Enum.RenderPriority.Last.Value, camStep)
	RunService:BindToRenderStep("NoctaliaRestoreCam", Enum.RenderPriority.First.Value, camRestore)
	RunService:BindToRenderStep("NoctaliaFlare", Enum.RenderPriority.Last.Value + 10, flareUpdate)
	camConn = RunService.RenderStepped:Connect(overlayTick)

	if CS.flareOn then
		loadFlare()
	end
end

function Cam.disable()
	if not Cam.on then
		return
	end

	Cam.on = false

	pcall(function()
		RunService:UnbindFromRenderStep("NoctaliaSmoothCam")
	end)
	pcall(function()
		RunService:UnbindFromRenderStep("NoctaliaRestoreCam")
	end)
	pcall(function()
		RunService:UnbindFromRenderStep("NoctaliaFlare")
	end)

	if camConn then
		camConn:Disconnect()
		camConn = nil
	end

	if origFov then
		cam.FieldOfView = origFov
		origFov = nil
	end

	Lighting.ExposureCompensation = Lighting.ExposureCompensation - appliedExposure
	appliedExposure, exposureAlpha = 0, 0

	for _, item in ipairs(flareSys.items) do
		item.em:Clear()
	end

	for key, instance in pairs(fx) do
		instance:Destroy()
		fx[key] = nil
	end

	if camGui then
		camGui.Enabled = false
	end

	resetCamState()
end

function Cam.destroy()
	Cam.disable()

	for _, item in ipairs(flareSys.items) do
		pcall(function()
			item.att:Destroy()
		end)
	end

	if camGui then
		camGui:Destroy()
		camGui = nil
	end
end

