local function addEffect(className, props)
	local effect = Instance.new(className)

	for name, value in pairs(props) do
		effect[name] = value
	end

	effect.Parent = Lighting

	return effect
end

local function addSky(starCount, skybox)
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("Sky") then
			child:Destroy()
		end
	end

	local sky = addEffect("Sky", {
		StarCount = math.min(starCount, 5000),
		CelestialBodiesShown = true,
	})

	if skybox then
		sky.SkyboxBk = skybox.Bk
		sky.SkyboxDn = skybox.Dn
		sky.SkyboxFt = skybox.Ft
		sky.SkyboxLf = skybox.Lf
		sky.SkyboxRt = skybox.Rt
		sky.SkyboxUp = skybox.Up
	end

	sky.Name = "Noctalia_Sky"
end

local function restoreOriginalSkies()
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("Sky") and child.Name == "Noctalia_Sky" then
			child:Destroy()
		end
	end

	if not findInstance("Sky") then
		for _, clone in ipairs(original.clones) do
			if clone:IsA("Sky") then
				clone:Clone().Parent = Lighting
			end
		end
	end
end

