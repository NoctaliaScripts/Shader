local function cleanup()
	pcall(Cam.destroy)
	clearAllLayers()

	for _, connection in ipairs(connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end

	table.clear(connections)
	ScreenGui:Destroy()
	env.NoctaliaCleanup = nil
end

