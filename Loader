		sliderRow(sub, label, 0, 255, 1, 1, function()
			local color = getValue() or Color3.new()

			return math.floor(({ color.R, color.G, color.B })[index] * 255 + 0.5)
		end, function(value)
			local color = getValue() or Color3.new()
			local parts = { math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5) }

			parts[index] = value
			setValue(Color3.fromRGB(parts[1], parts[2], parts[3]))
			swatch.BackgroundColor3 = Color3.fromRGB(parts[1], parts[2], parts[3])
		end)
	end

	channel("Red", 1)
	channel("Green", 2)
	channel("Blue", 3)

	swatch.MouseButton1Click:Connect(function()
		sub.Visible = not sub.Visible
	end)
	table.insert(refreshers, function()
