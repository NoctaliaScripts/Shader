-- options: function returning a list of names. Returns object with :refreshOptions().
local function dropdownRow(body, name, options, getValue, setValue)
	local holder = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	}, body)

	new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, holder)

	local main = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = ITEM,
		TextColor3 = TEXT,
		Font = Enum.Font.Gotham,
		TextSize = 11,
		Text = "",
		LayoutOrder = 1,
	}, holder)

	corner(main, 6)
	addStroke(main, STROKE, 1)

	local list = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundColor3 = PANEL,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = ACCENT,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
		LayoutOrder = 2,
	}, holder)

	corner(list, 6)
	addStroke(list, STROKE, 1)
	new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, list)

	local object = {}

	local function paintMain()
		main.Text = name .. ": " .. (getValue() or "—") .. (list.Visible and "  ▴" or "  ▾")
	end

	function object:refreshOptions()
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end

		local names = options()

		list.Size = UDim2.new(1, 0, 0, math.min(math.max(#names, 1), 6) * 22)

		if #names == 0 then
			new("TextButton", {
				Size = UDim2.new(1, 0, 0, 22),
				BackgroundTransparency = 1,
				Text = "(none)",
				TextColor3 = DIM,
				Font = Enum.Font.Gotham,
				TextSize = 11,
				Active = false,
			}, list)
		end

		for i, optionName in ipairs(names) do
			local item = new("TextButton", {
				Size = UDim2.new(1, 0, 0, 22),
				BackgroundColor3 = PANEL,
				BorderSizePixel = 0,
				Text = optionName,
				TextColor3 = TEXT,
				Font = Enum.Font.Gotham,
				TextSize = 11,
				LayoutOrder = i,
			}, list)

			item.MouseEnter:Connect(function()
				item.BackgroundColor3 = ITEM_HOVER
			end)
			item.MouseLeave:Connect(function()
				item.BackgroundColor3 = PANEL
			end)
			item.MouseButton1Click:Connect(function()
				list.Visible = false
				setValue(optionName)
				paintMain()
			end)
		end
	end

	main.MouseButton1Click:Connect(function()
		if not list.Visible then
			object:refreshOptions()
		end

		list.Visible = not list.Visible
		paintMain()
	end)
	table.insert(refreshers, paintMain)
	object:refreshOptions()
	paintMain()

	return object
end

